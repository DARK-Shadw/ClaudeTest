{
  "name": "hearthwild",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile-first colony sim prototype: a small settlement on a low-poly diorama, built to grow into a shared multiplayer world.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/balance.mjs && node node_modules/.cache/balance.mjs",
    "artifact": "vite build && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
